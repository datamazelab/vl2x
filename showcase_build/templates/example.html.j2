<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ title }} — vl2* showcase</title>
<link rel="stylesheet" href="../../assets/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github.min.css">
<script src="https://cdn.jsdelivr.net/npm/vega@5"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@5"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@6"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script type="importmap">
{ "imports": { "d3": "https://cdn.jsdelivr.net/npm/d3@7/+esm", "@observablehq/plot": "https://cdn.jsdelivr.net/npm/@observablehq/plot@0/+esm" } }
</script>
</head>
<body>
<header class="site-header">
  <a href="../../index.html">← All examples</a>
  <span class="sub">{{ title }}</span>
  <a class="github-link" href="https://github.com/datamazelab/vl2x" target="_blank" rel="noopener">GitHub</a>
</header>
<main>
  <div class="breadcrumb">
    {{ name }}.vl.json{% if category %} · category: {{ category }}{% endif %}
    <label class="source-path-toggle">
      <input type="checkbox" id="toggle-source-paths" checked>
      show <code>from:</code> source-mapping comments
    </label>
  </div>
  <h1 class="example-title">{{ title }}</h1>
  <p class="example-desc">{{ description or '&nbsp;' | safe }}</p>

  <div class="nav-arrows nav-arrows-top">
    {% if prev_name %}<a href="../{{ prev_name }}/index.html">← {{ prev_name }}</a>{% else %}<span></span>{% endif %}
    {% if next_name %}<a href="../{{ next_name }}/index.html">{{ next_name }} →</a>{% else %}<span></span>{% endif %}
  </div>

  <div class="compare-toolbar">
    <div class="view-toggle" role="group" aria-label="View mode">
      <button type="button" class="view-btn active" data-view="compare">Compare</button>
      <button type="button" class="view-btn" data-view="gallery">Show all visualizations</button>
    </div>
    <div class="tab-bar">
      <button type="button" class="tab-btn active" data-tab="altair">Altair {{ "✅" if altair.ok else "❌" }}</button>
      <button type="button" class="tab-btn" data-tab="vlapi">vl-api {{ "✅" if vlapi.ok else "❌" }}</button>
      <button type="button" class="tab-btn" data-tab="d3">D3 {{ "✅" if d3.ok else "❌" }}</button>
      <button type="button" class="tab-btn" data-tab="plot">Obs. Plot {{ "✅" if plot.ok else "❌" }}</button>
      <button type="button" class="tab-btn" data-tab="ggplot">ggplot2 {{ "✅" if (ggplot.ok and ggplot.has_png) else "❌" }}</button>
      <button type="button" class="tab-btn" data-tab="matplotlib">matplotlib {{ "✅" if (matplotlib.ok and matplotlib.has_png) else "❌" }}</button>
    </div>
  </div>

  <div class="compare-grid">

    <section class="panel source-panel" data-panel="source">
      <div class="panel-head"><span class="title">Vega-Lite (source)</span><span class="lang">ground truth</span></div>
      <div class="render-wrap"><div id="vis-original"></div></div>
      <div class="code-wrap"><pre><code class="language-json" id="spec-json"></code></pre></div>
    </section>

    <div class="tab-panels">

        <section class="panel tab-panel active" data-tab-panel="altair" data-panel="altair">
          <div class="panel-head"><span class="title">Altair {{ "✅" if altair.ok else "❌" }}</span><span class="lang">Python</span></div>
          {% if altair.ok %}
          <div class="render-wrap"><div id="vis-altair"></div></div>
          <div class="code-wrap"><pre><code class="language-python">{{ altair.code }}</code></pre></div>
          <div class="render-note">Altair compiles to a real Vega-Lite spec, so it renders via the same Vega-Lite/Vega runtime as the original above.</div>
          {% else %}
          <div class="error-box">{{ altair.error }}</div>
          {% endif %}
        </section>

        <section class="panel tab-panel" data-tab-panel="vlapi" data-panel="vlapi">
          <div class="panel-head"><span class="title">vega-lite-api {{ "✅" if vlapi.ok else "❌" }}</span><span class="lang">JavaScript</span></div>
          {% if vlapi.ok %}
          <div class="render-wrap"><div id="vis-vlapi"></div></div>
          <div class="code-wrap"><pre><code class="language-javascript">{{ vlapi.code }}</code></pre></div>
          <div class="render-note">vega-lite-api also compiles to a real Vega-Lite spec — same rendering path as the original.</div>
          {% else %}
          <div class="error-box">{{ vlapi.error }}</div>
          {% endif %}
        </section>

        <section class="panel tab-panel" data-tab-panel="d3" data-panel="d3">
          <div class="panel-head"><span class="title">D3 {{ "✅" if d3.ok else "❌" }}</span><span class="lang">JavaScript</span></div>
          {% if d3.translated %}
          <div class="render-wrap"><div id="vis-d3"></div></div>
          <div class="code-wrap"><pre><code class="language-javascript">{{ d3.code }}</code></pre></div>
          <div class="render-note">Generated D3 code running live in this page (no grammar-of-graphics layer — drawn from scratch). Built with <code>ignoreUnsupported</code>, so an unsupported feature may be dropped or approximated rather than reflected exactly.</div>
          {% else %}
          <div class="error-box">{{ d3.error }}</div>
          {% endif %}
        </section>

        <section class="panel tab-panel" data-tab-panel="plot" data-panel="plot">
          <div class="panel-head"><span class="title">Observable Plot {{ "✅" if plot.ok else "❌" }}</span><span class="lang">JavaScript</span></div>
          {% if plot.translated %}
          <div class="render-wrap"><div id="vis-plot"></div></div>
          <div class="code-wrap"><pre><code class="language-javascript">{{ plot.code }}</code></pre></div>
          <div class="render-note">Generated Observable Plot code running live in this page (Plot supplies its own grammar-of-graphics scales/legends/faceting). Built with <code>ignoreUnsupported</code>, so an unsupported feature may be dropped or approximated rather than reflected exactly.</div>
          {% else %}
          <div class="error-box">{{ plot.error }}</div>
          {% endif %}
        </section>

        <section class="panel tab-panel" data-tab-panel="ggplot" data-panel="ggplot">
          <div class="panel-head"><span class="title">ggplot2 {{ "✅" if (ggplot.ok and ggplot.has_png) else "❌" }}</span><span class="lang">R</span></div>
          {% if ggplot.ok and ggplot.has_png %}
          <div class="render-wrap"><img src="../../renders/{{ name }}.png" alt="ggplot2 render of {{ title }}"></div>
          <div class="code-wrap"><pre><code class="language-r">{{ ggplot.code }}</code></pre></div>
          <div class="render-note">Static PNG rendered ahead of time with R (can't run R in a browser). Built with <code>ignore_unsupported</code>, so an unsupported feature may be dropped or approximated rather than reflected exactly.</div>
          {% elif ggplot.ok %}
          <div class="code-wrap"><pre><code class="language-r">{{ ggplot.code }}</code></pre></div>
          <div class="error-box">Translated, but evaluating the generated R failed.</div>
          {% else %}
          <div class="error-box">{{ ggplot.error }}</div>
          {% endif %}
        </section>

        <section class="panel tab-panel" data-tab-panel="matplotlib" data-panel="matplotlib">
          <div class="panel-head"><span class="title">matplotlib {{ "✅" if (matplotlib.ok and matplotlib.has_png) else "❌" }}</span><span class="lang">Python</span></div>
          {% if matplotlib.ok and matplotlib.has_png %}
          <div class="render-wrap"><img src="../../renders_matplotlib/{{ name }}.png" alt="matplotlib render of {{ title }}"></div>
          <div class="code-wrap"><pre><code class="language-python">{{ matplotlib.code }}</code></pre></div>
          <div class="render-note">Static PNG rendered ahead of time (matplotlib can't run in a browser either). Built with <code>ignore_unsupported</code>, so an unsupported feature may be dropped or approximated rather than reflected exactly.</div>
          {% elif matplotlib.ok %}
          <div class="code-wrap"><pre><code class="language-python">{{ matplotlib.code }}</code></pre></div>
          <div class="error-box">Translated, but executing the generated Python failed.</div>
          {% else %}
          <div class="error-box">{{ matplotlib.error }}</div>
          {% endif %}
        </section>

    </div>

  </div>

  <div class="nav-arrows">
    {% if prev_name %}<a href="../{{ prev_name }}/index.html">← {{ prev_name }}</a>{% else %}<span></span>{% endif %}
    {% if next_name %}<a href="../{{ next_name }}/index.html">{{ next_name }} →</a>{% else %}<span></span>{% endif %}
  </div>
</main>
<footer class="site-footer">vl2altair · vl2vlapi · vl2d3 · vl2plot · vl2ggplot · vl2matplotlib — Vega-Lite translation showcase</footer>

<script>
  const spec = {{ spec_json | safe }};
  document.getElementById('spec-json').textContent = JSON.stringify(spec, null, 2);
  try {
    hljs.highlightAll();
  } catch (e) {
    console.error('syntax highlighting failed (charts below are unaffected):', e);
  }

  // Each of the 4 translators can optionally annotate its generated code
  // with a "# from: <json path>" / "// from: <json path>" comment above
  // the statement(s) it produced (see each project's own `include_source_
  // paths`/`includeSourcePaths` option) -- this showcase always builds
  // with that turned on, so every code panel below carries them. Rather
  // than a second, comment-stripped copy of every generated file, the
  // toggle just hides/shows them client-side: a plain `#`/`//` line
  // comment always highlight.js's own tokenizer isolates into its own
  // `.hljs-comment` span (a line comment can't span multiple lines), so
  // matching on that span's own text is a reliable, simple way to find
  // exactly the "from:" ones -- and only those -- without touching the
  // *other* comments a panel can carry (the provenance header, an
  // "unsupported feature" fallback note), which stay visible regardless.
  function setSourcePathCommentsVisible(visible) {
    document.querySelectorAll('.code-wrap code.hljs .hljs-comment').forEach(function (el) {
      var text = el.textContent.replace(/^\s+/, '');
      if (text.indexOf('# from: ') === 0 || text.indexOf('// from: ') === 0) {
        el.classList.toggle('source-path-comment-hidden', !visible);
      }
    });
  }
  var sourcePathToggle = document.getElementById('toggle-source-paths');
  if (sourcePathToggle) {
    setSourcePathCommentsVisible(sourcePathToggle.checked);
    sourcePathToggle.addEventListener('change', function () {
      setSourcePathCommentsVisible(sourcePathToggle.checked);
    });
  }

  // Tab bar (right column): only one tool's own panel body is shown at a
  // time -- every render underneath is already live-rendered regardless of
  // which tab is active (see the render scripts below), so switching tabs
  // is a pure CSS visibility flip, no re-render needed.
  var tabButtons = document.querySelectorAll('.tab-btn');
  var tabPanels = document.querySelectorAll('.tab-panel');
  tabButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabButtons.forEach(function (b) { b.classList.remove('active'); });
      tabPanels.forEach(function (p) { p.classList.remove('active'); });
      btn.classList.add('active');
      var target = document.querySelector('.tab-panel[data-tab-panel="' + btn.dataset.tab + '"]');
      if (target) target.classList.add('active');
    });
  });

  // "Show all visualizations": a `gallery-mode` class on <body> switches
  // the whole comparison over to CSS alone (see style.css) -- every tool's
  // own tab panel becomes visible at once, laid out in one grid alongside
  // the source panel, with all code/notes hidden so only the renders show.
  //
  // The chosen view is persisted across prev/next navigation via a
  // `?view=gallery` query param: read on load to restore state, and
  // re-written onto the prev/next nav-arrow links live (both here and
  // whenever the view toggle itself is clicked) so clicking through
  // examples keeps gallery mode instead of always resetting back to
  // "compare" on every new page.
  var viewButtons = document.querySelectorAll('.view-btn');
  var navArrowLinks = document.querySelectorAll('.nav-arrows a');
  function applyView(isGallery) {
    viewButtons.forEach(function (b) { b.classList.toggle('active', (b.dataset.view === 'gallery') === isGallery); });
    document.body.classList.toggle('gallery-mode', isGallery);
    navArrowLinks.forEach(function (a) {
      var url = new URL(a.href, location.href);
      if (isGallery) url.searchParams.set('view', 'gallery');
      else url.searchParams.delete('view');
      a.href = url.toString();
    });
  }
  applyView(new URLSearchParams(location.search).get('view') === 'gallery');
  viewButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var isGallery = btn.dataset.view === 'gallery';
      applyView(isGallery);
      var url = new URL(location.href);
      if (isGallery) url.searchParams.set('view', 'gallery');
      else url.searchParams.delete('view');
      history.replaceState(null, '', url);
    });
  });

  // Relative to *this page's own URL* (examples/<name>/index.html), not
  // domain-root -- so this still resolves to showcase/ when the site is
  // deployed under a subpath (e.g. https://host/vl2x/showcase/...). Used
  // both as vega-embed's loader baseURL (so a spec's own unmodified
  // relative "data/xyz.csv" data.url AND any relative path embedded in a
  // data *value* -- e.g. an "image" mark's per-row url field -- resolve
  // against showcase/data/, not against the example page's own directory)
  // and for the D3 panel below.
  const baseURL = new URL('../../', location.href).href;
  const vegaLoader = vega.loader({baseURL});

  vegaEmbed('#vis-original', spec, {actions: false, loader: vegaLoader}).catch(e => {
    document.getElementById('vis-original').innerHTML =
      '<div class="error-box">Vega-Lite render failed: ' + (e && e.message ? e.message : e) + '</div>';
  });
  {% if altair.ok %}
  vegaEmbed('#vis-altair', spec, {actions: false, loader: vegaLoader}).catch(e => {
    document.getElementById('vis-altair').innerHTML =
      '<div class="error-box">Render failed: ' + (e && e.message ? e.message : e) + '</div>';
  });
  {% endif %}
  {% if vlapi.ok %}
  vegaEmbed('#vis-vlapi', spec, {actions: false, loader: vegaLoader}).catch(e => {
    document.getElementById('vis-vlapi').innerHTML =
      '<div class="error-box">Render failed: ' + (e && e.message ? e.message : e) + '</div>';
  });
  {% endif %}
</script>
{% if d3.translated %}
<script type="module">
  import chart from './d3.js?v={{ d3.cachebust }}';
  const el = document.getElementById('vis-d3');
  try {
    const baseURL = new URL('../../', location.href).href;
    const node = await chart(el, {baseURL});
    if (node) el.appendChild(node);
  } catch (e) {
    el.innerHTML = '<div class="error-box">D3 render failed: ' + (e && e.message ? e.message : e) + '</div>';
  }
</script>
{% endif %}
{% if plot.translated %}
<script type="module">
  import chart from './plot.js?v={{ plot.cachebust }}';
  const el = document.getElementById('vis-plot');
  try {
    const baseURL = new URL('../../', location.href).href;
    const node = await chart(el, {baseURL});
    if (node) el.appendChild(node);
  } catch (e) {
    el.innerHTML = '<div class="error-box">Plot render failed: ' + (e && e.message ? e.message : e) + '</div>';
  }
</script>
{% endif %}
</body>
</html>
